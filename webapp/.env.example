# Copia este fichero a .env.local (nunca se commitea) y rellena con las credenciales
# reales del proyecto de Supabase — pídelas al equipo, no inventes valores de prueba.
# En el dashboard de Supabase: Project Settings → API Keys.

# Project URL (Project Settings → API Keys → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key — antes llamada "anon key". Segura de exponer en cliente,
# la protección real la da RLS (ver specs/003-persistencia-real/research.md §3).
# NUNCA pongas aquí una "Secret key" / service_role — esa no es para el navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
